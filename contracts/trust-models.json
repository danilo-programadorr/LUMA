      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "brain_version": {
        "title": "Brain Version",
        "type": "string"
      },
      "engine_version": {
        "title": "Engine Version",
        "type": "string"
      },
      "query": {
        "title": "Query",
        "type": "string"
      },
      "results": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Results",
        "type": "array"
      },
      "sources": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Sources",
        "type": "array"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      },
      "permission_status": {
        "const": "NOT_DETERMINED_BY_RETRIEVAL",
        "title": "Permission Status",
        "type": "string"
      },
      "retrieved_at": {
        "format": "date-time",
        "title": "Retrieved At",
        "type": "string"
      },
      "request_id": {
        "title": "Request Id",
        "type": "string"
      },
      "correlation_id": {
        "title": "Correlation Id",
        "type": "string"
      },
      "mode": {
        "const": "lexical",
        "default": "lexical",
        "title": "Mode",
        "type": "string"
      },
      "status": {
        "title": "Status",
        "type": "string"
      },
      "confidence": {
        "title": "Confidence",
        "type": "string"
      },
      "content_trust": {
        "const": "UNTRUSTED_DATA",
        "default": "UNTRUSTED_DATA",
        "title": "Content Trust",
        "type": "string"
      }
    },
    "required": [
      "project_id",
      "brain_version",
      "engine_version",
      "query",
      "results",
      "sources",
      "warnings",
      "permission_status",
      "request_id",
      "correlation_id",
      "status",
      "confidence"
    ],
    "title": "KnowledgeContext",
    "type": "object"
  },
