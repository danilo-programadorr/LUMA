{
  "ProposalDecision": {
    "$defs": {
      "AnswerCitation": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Document Id",
            "type": "string"
          },
          "chunk_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Chunk Id",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "chunk_id"
        ],
        "title": "AnswerCitation",
        "type": "object"
      },
      "LearningProposal": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Claim",
            "type": "string"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          }
        },
        "required": [
          "claim",
          "evidence"
        ],
        "title": "LearningProposal",
        "type": "object"
      },
      "ToolCallProposal": {
        "additionalProperties": false,
        "properties": {
          "tool_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Tool Id",
            "type": "string"
          },
          "capability": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Capability",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "reason": {
            "maxLength": 1000,
            "title": "Reason",
            "type": "string"
          },
          "correlation_id": {
            "maxLength": 64,
            "title": "Correlation Id",
            "type": "string"
          }
        },
        "required": [
          "tool_id",
          "capability",
          "reason",
          "correlation_id"
        ],
        "title": "ToolCallProposal",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "clarification_reason_code": {
        "default": null,
        "title": "Clarification Reason Code",
        "type": "null"
      },
      "review_recommendation": {
        "anyOf": [
          {
            "enum": [
              "approve_review",
              "warn",
              "raise_risk",
              "reject_candidate"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Review Recommendation"
      },
      "assistant_message": {
        "maxLength": 4000,
        "title": "Assistant Message",
        "type": "string"
      },
      "intent": {
        "maxLength": 1000,
        "title": "Intent",
        "type": "string"
      },
      "proposed_actions": {
        "items": {
          "$ref": "#/$defs/ToolCallProposal"
        },
        "maxItems": 3,
        "minItems": 1,
        "title": "Proposed Actions",
        "type": "array"
      },
      "requested_knowledge": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Requested Knowledge",
        "type": "array"
      },
      "confidence": {
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "needs_clarification": {
        "const": false,
        "default": false,
        "title": "Needs Clarification",
        "type": "boolean"
      },
      "citations": {
        "default": [],
        "items": {
          "$ref": "#/$defs/AnswerCitation"
        },
        "maxItems": 5,
        "title": "Citations",
        "type": "array"
      },
      "learning_candidates": {
        "default": [],
        "items": {
          "$ref": "#/$defs/LearningProposal"
        },
        "maxItems": 2,
        "title": "Learning Candidates",
        "type": "array"
      }
    },
    "required": [
      "assistant_message",
      "intent",
      "proposed_actions",
      "confidence"
    ],
    "title": "ProposalDecision",
    "type": "object"
  },
