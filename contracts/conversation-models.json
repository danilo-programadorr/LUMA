    "additionalProperties": false,
    "properties": {
      "clarification_reason_code": {
        "anyOf": [
          {
            "enum": [
              "MISSING_REQUIRED_PARAMETERS",
              "UNSUPPORTED_OPERATION",
              "AMBIGUOUS_REQUEST"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Clarification Reason Code"
      },
      "review_recommendation": {
        "anyOf": [
          {
            "enum": [
              "approve_review",
              "warn",
              "raise_risk",
              "reject_candidate"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Review Recommendation"
      },
      "assistant_message": {
        "maxLength": 4000,
        "title": "Assistant Message",
        "type": "string"
      },
      "intent": {
        "maxLength": 1000,
        "title": "Intent",
        "type": "string"
      },
      "proposed_actions": {
        "default": [],
        "items": {
          "$ref": "#/$defs/ToolCallProposal"
        },
        "maxItems": 3,
        "title": "Proposed Actions",
        "type": "array"
      },
      "requested_knowledge": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Requested Knowledge",
        "type": "array"
      },
      "confidence": {
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "needs_clarification": {
        "default": false,
        "title": "Needs Clarification",
        "type": "boolean"
      },
      "citations": {
        "default": [],
        "items": {
          "$ref": "#/$defs/AnswerCitation"
        },
        "maxItems": 5,
        "title": "Citations",
        "type": "array"
      },
      "learning_candidates": {
        "default": [],
        "items": {
          "$ref": "#/$defs/LearningProposal"
        },
        "maxItems": 2,
        "title": "Learning Candidates",
        "type": "array"
      }
    },
    "required": [
      "assistant_message",
      "intent",
      "confidence"
    ],
    "title": "ModelDecision",
    "type": "object"
  },
