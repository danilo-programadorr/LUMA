LUMA_OWNER_TOKEN=
LUMA_RUNTIME_TOKEN=
LUMA_KNOWLEDGE_TOKEN=
LUMA_KNOWLEDGE_ENDPOINT=
LUMA_HOST=
LUMA_PORT=
LUMA_TIMEOUT=
LUMA_KNOWLEDGE_HISTORY=
LUMA_KNOWLEDGE_PACKAGES=

LUMA_DATABASE_URL=
# Separate confirmation secret for authenticated administrative approval/unlock.
LUMA_ADMIN_CONFIRM_TOKEN=

# Model layer: disabled until explicitly configured. Never commit actual credentials.
LUMA_MODEL_PROVIDER=
LUMA_GEMINI_API_KEY=
LUMA_GEMINI_MODEL=
LUMA_MODEL_TIMEOUT=
LUMA_MODEL_MAX_INPUT_CHARS=
LUMA_MODEL_MAX_KNOWLEDGE_CHARS=
LUMA_MODEL_MAX_CONVERSATION_CHARS=
# CONVERSATIONAL is fixed server-side: thinking_level=low, max_output_tokens=32768.
# No temperature/top_p/top_k override. Legacy output/sampling variables are ignored.
LUMA_CONTROL_PLANE_URL=
LUMA_DEVICE_ID=
LUMA_DEVICE_CREDENTIAL=

# CONTROL_PLANE | LOCAL_RUNTIME | LOCAL_DEV (default). Unknown values fail closed.
LUMA_MODE=LOCAL_DEV
LUMA_REGISTRY_VERSION=

# 7F-B explicit Owner identity mode; LOCAL_TOKEN is local legacy only.
LUMA_OWNER_AUTH_MODE=LOCAL_TOKEN
LUMA_IDENTITY_PROJECT=
# IDENTITY_PLATFORM requires migration --owner; no long-lived Google key.

# Phase 7F-D-A local research (defaults disabled; real use requires Owner gates)
LUMA_RESEARCH_ENABLED=0
LUMA_RESEARCH_REAL_APPROVED=0
LUMA_RESEARCH_ATTRIBUTION_APPROVED=0
LUMA_RESEARCH_MAX_CALLS=0

# Optional private library; local device and schema8 required
LUMA_PRIVATE_LIBRARY_ENABLED=0
