LUMA_OWNER_TOKEN=
LUMA_RUNTIME_TOKEN=
LUMA_KNOWLEDGE_TOKEN=
LUMA_KNOWLEDGE_ENDPOINT=http://127.0.0.1:8765
LUMA_HOST=127.0.0.1
LUMA_PORT=8770
LUMA_TIMEOUT=3
LUMA_KNOWLEDGE_HISTORY=false
LUMA_KNOWLEDGE_PACKAGES=

LUMA_DATABASE_URL=sqlite:///runtime/luma.db
# Separate confirmation secret for authenticated administrative approval/unlock.
LUMA_ADMIN_CONFIRM_TOKEN=

# Model layer: disabled until explicitly configured. Never commit actual credentials.
LUMA_MODEL_PROVIDER=disabled
LUMA_GEMINI_API_KEY=
LUMA_GEMINI_MODEL=
LUMA_MODEL_TIMEOUT=30
LUMA_MODEL_MAX_INPUT_CHARS=2000
LUMA_MODEL_MAX_KNOWLEDGE_CHARS=24000
LUMA_MODEL_MAX_CONVERSATION_CHARS=8000
LUMA_MODEL_MAX_OUTPUT_TOKENS=2048
LUMA_MODEL_TEMPERATURE=0.2
